{
  "name": "retroville-unleashed",
  "productName": "Retroville Unleashed",
  "version": "1.1.0",
  "description": "Open-world 3D Jimmy Neutron fan game: roam Retroville with Goddard, inventions, vehicles, missions and bosses.",
  "main": "desktop/main.js",
  "homepage": "https://github.com/deshauncottrell2-jpg/j.i.n-game",
  "author": {
    "name": "deshauncottrell2-jpg",
    "email": "deshauncottrell2-jpg@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "io.github.deshauncottrell2jpg.retrovilleunleashed",
    "productName": "Retroville Unleashed",
    "artifactName": "Retroville-Unleashed-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "vendor/**",
      "build/icon.png",
      "desktop/**"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "synopsis": "Open-world Jimmy Neutron fan game"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Retroville Unleashed"
    },
    "afterPack": "build/afterPack.js"
  }
}
